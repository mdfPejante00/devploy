{
  "name": "@chiake/devploy",
  "version": "1.2.0",
  "description": "Modern & Scalable Node.js Server Deployment CLI",
  "type": "module",
  "bin": {
    "devploy": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cli",
    "deploy",
    "deployment",
    "ssh",
    "rsync",
    "docker",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "boxen": "^7.1.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.3.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "ssh2": "^1.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/ssh2": "^1.15.1",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
